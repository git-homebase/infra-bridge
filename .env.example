# infra-bridge — required env (names only). NEVER commit a value; secrets live in Coolify.

# Where the queue listens. Local dev uses the registered port 5198 on loopback; the container
# listens on 3000 and binds 0.0.0.0 (set in the Dockerfile).
PORT=5198
HOST=127.0.0.1

# The unguessable path segment. Every real route lives under /c/<SECRET>/ ; anything else is a 404.
# Generate with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SECRET=

# The token ChatGPT sends (Authorization: Bearer <token>) to POST a command. This one leaves the
# house — it gets pasted into a third-party product — so it can only ADD to the queue.
BRIDGE_WRITE_TOKEN=

# The token the local sync agent sends to pull and to ack. This one never leaves Gitit's PC.
# Deliberately a different value: a leaked write token must not be able to drain or read the queue.
BRIDGE_AGENT_TOKEN=

# Where commands wait. A Coolify persistent volume in production (/data/queue).
QUEUE_DIR=./queue

# A command nobody collected is deleted after this long — the safety valve that stops a command
# the Center server keeps rejecting from being retried forever.
COMMAND_TTL_MINUTES=60

# How long an ACKed command id is remembered (hash only, no content), so a late replay of the same
# command is still refused.
SEEN_TTL_DAYS=7
